{
  "$schema": "https://opencode.ai/config.json",
  "model": "azure_bialaexpress/gpt-6-astra",
  "logLevel": "INFO",
  "enabled_providers": [
    "amazon-bedrock",
    "azure_bialaexpress"
  ],
  "agent": {
    "general": {
      "steps": 80
    },
    "explore": {
      "steps": 40
    }
  },
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-west-2",
        "timeout": 180000,
        "chunkTimeout": 60000
      },
      "models": {
        "xai.grok-4.6": {
          "name": "Grok 4.6 (US West — Oregon)",
          "provider": {
            "npm": "@ai-sdk/amazon-bedrock/mantle",
            "api": "https://bedrock-mantle.us-west-2.api.aws/openai/v1"
          }
        }
      }
    },
    "azure_bialaexpress": {
      "npm": "@ai-sdk/openai",
      "name": "Azure Bialaexpress",
      "options": {
        "baseURL": "https://bialaexpress-0800-gpt-6-resource.services.ai.azure.com/openai/v1",
        "apiKey": "{file:/home/mohammed/.config/credentials/azure-bialaexpress.key}",
        "timeout": 180000
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra (Azure)",
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
            "store": false
          }
        }
      }
    }
  },
  "small_model": "azure_bialaexpress/gpt-6-astra"
}
