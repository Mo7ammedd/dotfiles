# HTOP Color Configuration Template
# This template generates a custom htoprc configuration with themed colors
# Colors are defined using terminal color codes (0-255) or RGB hex values

# htoprc configuration with custom colors
fields=0 48 17 18 38 39 40 2 46 47 49 1
sort_key=46
sort_direction=-1
tree_sort_key=0
tree_sort_direction=1
hide_kernel_threads=1
hide_userland_threads=0
shadow_other_users=0
show_thread_names=0
show_program_path=1
highlight_base_name=0
highlight_deleted_exe=1
highlight_megabytes=1
highlight_threads=1
highlight_changes=0
highlight_changes_delay_secs=5
find_comm_in_cmdline=1
strip_exe_from_cmdline=1
show_merged_command=0
tree_view=0
tree_view_always_by_pid=0
all_branches_collapsed=0
header_margin=1
detailed_cpu_time=0
cpu_count_from_one=0
show_cpu_usage=1
show_cpu_frequency=0
show_cpu_temperature=0
degree_fahrenheit=0
update_process_names=0
account_guest_in_cpu_meter=0
color_scheme=6

# Custom color definitions using template variables
# Main interface colors
color_background=#0e0e12
color_text=#e7e4f0
color_highlight=#c4c2ee
color_selected=#191920

# CPU meter colors (gradient)
color_cpu_low=#c8e3ff
color_cpu_med=#ffecf3
color_cpu_high=#c2a5fd

# Memory meter colors
color_mem_used=#b1b7ff
color_mem_buffers=#d4dfff
color_mem_cache=#b8c5ff
color_mem_available=#c8e3ff

# Process list colors
color_process_normal=#e7e4f0
color_process_running=#c8e3ff
color_process_sleeping=#76747f
color_process_zombie=#c2a5fd
color_process_stopped=#ffecf3

# Header and border colors
color_header=#acaab5
color_border=#76747f
color_separator=#484750

# Function key colors
color_function_key=#ffe7fd
color_function_desc=#e7e4f0

# Tree view colors
color_tree_line=#76747f
color_tree_collapsed=#c4c2ee
color_tree_expanded=#c6c4dd

# Load average colors
color_load_low=#c8e3ff
color_load_med=#ffecf3
color_load_high=#c2a5fd

# Priority colors
color_priority_high=#c2a5fd
color_priority_normal=#e7e4f0
color_priority_low=#76747f

# Swap meter colors
color_swap_used=#cab5ed
color_swap_cache=#e1c2f9

# Temperature colors (if enabled)
color_temp_cool=#c8e3ff
color_temp_warm=#ffecf3
color_temp_hot=#c2a5fd
