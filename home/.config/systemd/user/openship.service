[Unit]
Description=Openship control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/bun /home/mohammed/Desktop/openship/apps/cli/dist/index.js up --foreground --port 4000 --dashboard-port 3001 --ui-version v0.3.0 --public-url https://mooo.opsh.io --trust-proxy
Restart=always
RestartSec=2
Environment=NODE_ENV=production
Environment=OPENSHIP_DASHBOARD_DIR=/home/mohammed/Desktop/openship/apps/dashboard/.next/standalone

[Install]
WantedBy=default.target
